# Copie para .env (não versione o arquivo com secrets reais)
# Ver docs/2.0/variaveis.md

HOST=127.0.0.1
PORT=8787
TZ=America/Cuiaba

# Obrigatório em produção (NODE_ENV=production). Mínimo 32 caracteres.
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url')+'\n')"
BETTER_AUTH_SECRET=troque-por-32-caracteres-aleatorios-minimo

# URL pública do painel. Em preview, deixe vazio para inferir o Host.
BETTER_AUTH_URL=http://127.0.0.1:8787

# Pasta do SQLite. No Docker use /data
# N8N_MONITOR_DATA_DIR=

# Opcional: semeia a primeira instância no import JSON legado
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=
