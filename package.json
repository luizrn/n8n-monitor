{
  "name": "n8n-monitor",
  "version": "2.0.0",
  "private": true,
  "description": "Painel open source de monitoramento para n8n e Uptime Kuma, com alertas, tarefas e integrações de entrega",
  "author": "Luiz Fernando Riva Nekel",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "compile": "tsc",
    "prebuild": "npm run test:unit && npm run test:html && npm run test:docs",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:unit": "tsx --test test/alertas.test.ts test/rdap.test.ts test/seguranca.test.ts test/tarefas.test.ts test/uptime.test.ts test/webhook.test.ts",
    "test:server": "tsx --test --test-concurrency=1 test/server.test.ts",
    "test:html": "tsx --test test/html.test.ts test/i18n.test.ts",
    "test:docs": "tsx --test test/docs.test.ts",
    "test:file": "tsx --test",
    "check": "tsc --noEmit",
    "diag": "tsx scripts/diag-exec.ts",
    "dump": "tsx scripts/dump-wf.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/luizrn/n8n-monitor.git" },
  "bugs": { "url": "https://github.com/luizrn/n8n-monitor/issues" },
  "homepage": "https://github.com/luizrn/n8n-monitor#readme",
  "keywords": ["n8n", "monitoring", "observability", "uptime-kuma", "docker"]
}
